#!/bin/sh
case "${1:-}" in
    version) printf '%s\n' 'arduino-cli 1.0.0' ;;
    core)
        if [ "${2:-}" = list ]; then
            if [ "${DOCTOR_MOCK_ARDUINO:-}" != missing ]; then
                printf '%s\n' 'arduino:avr 1.0.0 Arduino AVR Boards' 'arduboy-homemade:avr 1.0.0 Arduboy Homemade';
            fi
        fi
        ;;
    lib)
        if [ "${2:-}" = list ] && [ "${DOCTOR_MOCK_ARDUINO:-}" != missing ]; then
            printf '%s\n' 'Arduboy2 7.0.0' 'ArdBitmap 1.0.0';
        fi
        ;;
esac
